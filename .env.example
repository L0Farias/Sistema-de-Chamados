# ──────────────────────────────────────────
# Configurações do Django
# ──────────────────────────────────────────
SECRET_KEY=sua-chave-secreta-aqui
DEBUG=True

# ──────────────────────────────────────────
# Configurações de Email (SMTP Gmail)
# ──────────────────────────────────────────
EMAIL_HOST_USER=seu-email@gmail.com
EMAIL_HOST_PASSWORD=sua-senha-de-app-gmail

# ──────────────────────────────────────────
# Google Calendar API — Service Account
#
# Como configurar:
#   1. Acesse https://console.cloud.google.com/
#   2. Crie um projeto (ou use um existente)
#   3. Ative a API "Google Calendar API"
#   4. Crie uma Service Account em IAM & Admin > Service Accounts
#   5. Gere uma chave JSON para a Service Account
#   6. Salve o arquivo JSON em local seguro FORA do repositório Git
#   7. Compartilhe o calendário com o e-mail da Service Account
#      (com permissão "Make changes to events")
#   8. Preencha as variáveis abaixo
# ──────────────────────────────────────────

# Caminho absoluto ou relativo para o arquivo JSON da Service Account
# Exemplo: /home/usuario/credenciais/service_account.json
# NUNCA commite este arquivo no Git
GOOGLE_SERVICE_ACCOUNT_FILE=/caminho/para/service_account.json

# ID do Google Calendar que será usado para verificar conflitos e criar eventos
# Encontrado em: Google Calendar > Configurações do Calendário > ID do calendário
# Exemplo: abc123xyz@group.calendar.google.com
GOOGLE_CALENDAR_ID=id-do-seu-calendario@group.calendar.google.com

# ──────────────────────────────────────────
# NOTA: Se GOOGLE_SERVICE_ACCOUNT_FILE ou GOOGLE_CALENDAR_ID estiverem
# ausentes/vazios, o sistema funcionará normalmente mas SEM integração
# com Google Calendar (agendamentos serão criados sem verificação de conflito).
# ──────────────────────────────────────────
